<?xml version="1.0" encoding="utf-8"?>
<!-- Odoo 18/19 record rules. The 20.0 build folds them into security/ir.access.csv (column "domain"). -->
<odoo>
    <record id="access_umc_mailbox_user_rule" model="ir.rule">
        <field name="name">Email Client: mailboxes I own or am a member of</field>
        <field name="model_id" ref="model_umc_mailbox"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('user_ids', 'in', [user.id])]</field>
    </record>
    <record id="access_umc_mailbox_admin_rule" model="ir.rule">
        <field name="name">Email Client: administrators see every mailbox</field>
        <field name="model_id" ref="model_umc_mailbox"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="access_umc_mailbox_member_user_rule" model="ir.rule">
        <field name="name">Email Client: members of my mailboxes</field>
        <field name="model_id" ref="model_umc_mailbox_member"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('mailbox_id.owner_id', '=', user.id), ('mailbox_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="access_umc_mailbox_member_admin_rule" model="ir.rule">
        <field name="name">Email Client: administrators see every member</field>
        <field name="model_id" ref="model_umc_mailbox_member"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="access_umc_mailbox_company_rule" model="ir.rule">
        <field name="name">Email Client: multi-company</field>
        <field name="model_id" ref="model_umc_mailbox"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="access_umc_folder_user_rule" model="ir.rule">
        <field name="name">Email Client: folders of my mailboxes</field>
        <field name="model_id" ref="model_umc_folder"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('mailbox_id.owner_id', '=', user.id), ('mailbox_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="access_umc_thread_user_rule" model="ir.rule">
        <field name="name">Email Client: threads of my mailboxes</field>
        <field name="model_id" ref="model_umc_thread"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('mailbox_id.owner_id', '=', user.id), ('mailbox_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="access_umc_message_user_rule" model="ir.rule">
        <field name="name">Email Client: messages of my mailboxes</field>
        <field name="model_id" ref="model_umc_message"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('mailbox_id.owner_id', '=', user.id), ('mailbox_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="access_umc_thread_company_rule" model="ir.rule">
        <field name="name">Email Client: conversations multi-company</field>
        <field name="model_id" ref="model_umc_thread"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="umc_signature_user_rule" model="ir.rule">
        <field name="name">Email Client: my signatures and shared signatures of my mailboxes</field>
        <field name="model_id" ref="model_umc_signature"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), '&amp;', ('owner_id', '=', False), '|', ('mailbox_id.owner_id', '=', user.id), ('mailbox_id.user_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="umc_signature_user_write_rule" model="ir.rule">
        <field name="name">Email Client: change my signatures, and shared ones of mailboxes I manage</field>
        <field name="model_id" ref="model_umc_signature"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), '&amp;', ('owner_id', '=', False), ('mailbox_id.owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
    <record id="umc_record_link_user_rule" model="ir.rule">
        <field name="name">Email Client: links of my mailboxes</field>
        <field name="model_id" ref="model_umc_record_link"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('mailbox_id.owner_id', '=', user.id), ('mailbox_id.user_ids', 'in', [user.id])]</field>
    </record>
</odoo>
