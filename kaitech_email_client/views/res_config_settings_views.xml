<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_umc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kaitech_email_client</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Email Client" string="Email Client" name="kaitech_email_client"
                     logo="/kaitech_email_client/static/description/icon.png" groups="base.group_system">
                    <block title="Gmail and Microsoft 365 (OAuth2)" name="umc_oauth">
                        <setting string="Redirect URI" help="Register this exact URL in Google Cloud Console and in Microsoft Entra.">
                            <field name="umc_oauth_redirect_uri" readonly="1" widget="CopyClipboardChar"/>
                        </setting>
                        <setting string="Google Workspace / Gmail" help="OAuth client of type 'Web application' with the Gmail API enabled.">
                            <div class="row mt-2">
                                <label for="umc_google_client_id" class="col-lg-4 o_light_label"/>
                                <field name="umc_google_client_id"/>
                            </div>
                            <div class="row">
                                <label for="umc_google_client_secret" class="col-lg-4 o_light_label"/>
                                <field name="umc_google_client_secret" password="True"/>
                            </div>
                        </setting>
                        <setting string="Microsoft 365 / Outlook" help="App registration with IMAP.AccessAsUser.All and SMTP.Send (Office 365 Exchange Online).">
                            <div class="row mt-2">
                                <label for="umc_microsoft_client_id" class="col-lg-4 o_light_label"/>
                                <field name="umc_microsoft_client_id"/>
                            </div>
                            <div class="row">
                                <label for="umc_microsoft_client_secret" class="col-lg-4 o_light_label"/>
                                <field name="umc_microsoft_client_secret" password="True"/>
                            </div>
                            <div class="row">
                                <label for="umc_microsoft_tenant" class="col-lg-4 o_light_label"/>
                                <field name="umc_microsoft_tenant" placeholder="common"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_umc_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'kaitech_email_client'}</field>
    </record>
</odoo>
