<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kai_pos_promotion</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="after">
                <block title="Promotions" id="kai_pos_promotion_section">
                    <setting id="kai_pos_promotion_timezone" string="Promotion timezone" help="Happy hours of this point of sale follow this timezone, not the timezone of the cashier.">
                        <field name="pos_kai_timezone"/>
                        <div class="mt-2">
                            <button name="%(kai_pos_promotion.kai_pos_promo_action)d" type="action" string="POS Promotions" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
