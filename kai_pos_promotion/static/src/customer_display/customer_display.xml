<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kai_pos_promotion.CustomerDisplay" t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='order.amount and !order.finalized']" position="before">
            <div t-if="order.kaiBanner and !order.finalized" class="o_kai_promo_banner mx-3 my-2 px-3 py-2 rounded-3 text-bg-warning fs-4 fw-bold text-center" t-esc="order.kaiBanner"/>
        </xpath>
    </t>
</templates>
