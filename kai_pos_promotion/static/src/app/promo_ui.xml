<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kai_pos_promotion.OrderSummary" t-inherit="point_of_sale.OrderSummary" t-inherit-mode="extension">
        <xpath expr="//OrderDisplay" position="before">
            <div t-if="kaiBanner and currentOrder.lines.length" class="o_kai_promo_banner d-flex align-items-center gap-2 mx-2 mt-2 px-3 py-2 rounded-3 fw-bold"
                t-att-class="kaiBanner.kind === 'reached' ? 'text-bg-success' : 'text-bg-warning'" role="status">
                <i class="fa fa-bullhorn" aria-hidden="true"/>
                <span t-esc="kaiBanner.text"/>
            </div>
        </xpath>
    </t>
    <t t-name="kai_pos_promotion.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//article" position="inside">
            <span t-if="kaiHappyHour" class="o_kai_happy_hour position-absolute top-0 start-0 end-0 m-1 px-1 py-1 rounded-3 text-bg-danger fw-bold text-center lh-sm small" t-esc="kaiHappyHour"/>
        </xpath>
    </t>
</templates>
