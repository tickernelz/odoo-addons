<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_kai_promo" model="res.groups.privilege">
        <field name="name">POS Promotions</field>
        <field name="sequence">27</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_kai_promo_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_kai_promo"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_kai_promo_approver'))]"/>
    </record>

    <record id="rule_kai_pos_promo_company" model="ir.rule">
        <field name="name">POS Promotion: company</field>
        <field name="model_id" ref="model_kai_pos_promo"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
