<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_tree" model="ir.ui.view">
        <field name="name">pos.payment.list.inherit.pos_checkout_extras</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_order_id']" position="after">
                <field name="payment_reference" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_search" model="ir.ui.view">
        <field name="name">pos.payment.search.inherit.pos_checkout_extras</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pos_order_id']" position="after">
                <field name="payment_reference"/>
                <filter string="With payment reference" name="with_payment_reference" domain="[('payment_reference', '!=', False)]"/>
                <filter string="Without payment reference" name="without_payment_reference" domain="[('payment_reference', '=', False)]"/>
            </xpath>
            <xpath expr="//filter[@name='group_by_session']" position="after">
                <filter name="group_by_payment_reference" string="Payment Reference" domain="[]" context="{'group_by': 'payment_reference'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_pivot" model="ir.ui.view">
        <field name="name">pos.payment.pivot</field>
        <field name="model">pos.payment</field>
        <field name="arch" type="xml">
            <pivot string="Payments" sample="1">
                <field name="payment_method_id" type="row"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_pos_payment_graph" model="ir.ui.view">
        <field name="name">pos.payment.graph</field>
        <field name="model">pos.payment</field>
        <field name="arch" type="xml">
            <graph string="Payments" sample="1">
                <field name="payment_method_id"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="point_of_sale.action_pos_payment_form" model="ir.actions.act_window">
        <field name="view_mode">list,pivot,graph,form</field>
    </record>
</odoo>
