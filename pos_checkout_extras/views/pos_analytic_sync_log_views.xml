<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_analytic_sync_log_view_list" model="ir.ui.view">
        <field name="name">pos.analytic.sync.log.list</field>
        <field name="model">pos.analytic.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="config_id"/>
                <field name="kind"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="mode"/>
                <field name="updated_count" sum="Updated"/>
                <field name="skipped_count"/>
            </list>
        </field>
    </record>

    <record id="action_pos_analytic_sync_log" model="ir.actions.act_window">
        <field name="name">Analytic Sync Log</field>
        <field name="res_model">pos.analytic.sync.log</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_pos_analytic_sync_log"
        name="Analytic Sync Log"
        parent="point_of_sale.menu_point_config_product"
        action="action_pos_analytic_sync_log"
        groups="point_of_sale.group_pos_manager"
        sequence="90"/>
</odoo>
