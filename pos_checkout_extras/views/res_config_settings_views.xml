<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_checkout_extras</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_accounting_section']" position="after">
                <block title="Checkout Extras" id="pos_checkout_extras_section">
                    <setting id="pos_customer_required" string="Customer required" help="The cashier cannot finish an order of this point of sale until a customer is set.">
                        <field name="pos_customer_required_mode" widget="radio"/>
                        <div class="text-muted">Refunds and unpaid draft orders are never blocked. Orders created before this option was turned on are accepted.</div>
                    </setting>
                    <setting id="pos_payment_reference" string="Payment Reference" help="Let the cashier add a reference to an order from the payment screen, for example a transfer number or an EDC approval code. It is printed on the receipt and kept on the order.">
                        <field name="pos_allow_payment_reference"/>
                    </setting>
                    <setting id="pos_analytic_distribution" string="Analytic Distribution" help="Added to the journal items created when a session of this point of sale is closed." groups="analytic.group_analytic_accounting">
                        <field name="analytic_precision" invisible="1"/>
                        <div class="content-group mt-2">
                            <field name="pos_analytic_distribution" widget="analytic_distribution" options="{'business_domain': 'general'}"/>
                            <div class="row mt-2">
                                <label string="Apply to" for="pos_analytic_scope" class="col-lg-3 o_light_label"/>
                                <field name="pos_analytic_scope" class="col-lg-9"/>
                            </div>
                            <div class="text-muted mt-2">Changing the distribution only affects sessions closed afterwards. Use Synchronise to update journal items that already exist.</div>
                            <div class="mt-2">
                                <button name="action_pos_analytic_sync_current" type="object" string="Synchronise this counter" icon="oi-arrow-right" class="btn-link"/>
                                <button name="action_pos_analytic_sync_all" type="object" string="Synchronise all counters" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
