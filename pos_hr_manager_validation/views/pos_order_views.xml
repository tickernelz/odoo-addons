<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.pos_hr_manager_validation</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='refund']" position="attributes">
                <attribute name="name">action_mv_refund</attribute>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="not mv_flagged">
                    <field name="mv_flagged" invisible="1"/>
                    <span>Done without manager validation: </span>
                    <field name="mv_unvalidated_display" class="fw-bold"/>
                    <button name="action_mv_mark_checked" type="object" string="Mark as Checked"
                            class="btn-link" groups="point_of_sale.group_pos_manager"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree" model="ir.ui.view">
        <field name="name">pos.order.list.inherit.pos_hr_manager_validation</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="mv_unvalidated_display" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_filter" model="ir.ui.view">
        <field name="name">pos.order.search.inherit.pos_hr_manager_validation</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="mv_flagged" string="Unvalidated Actions" domain="[('mv_flagged', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
