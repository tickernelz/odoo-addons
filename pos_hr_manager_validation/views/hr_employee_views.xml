<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.pos_hr_manager_validation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pin']" position="after">
                <field name="pos_validation_pin" password="True" placeholder="6 to 12 digits"
                       groups="hr.group_hr_user"/>
                <field name="pos_validation_pin_set" groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>
</odoo>
