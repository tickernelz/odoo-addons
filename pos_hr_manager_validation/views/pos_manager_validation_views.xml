<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_manager_validation_view_list" model="ir.ui.view">
        <field name="name">pos.manager.validation.list</field>
        <field name="model">pos.manager.validation</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false" decoration-danger="not success" decoration-muted="cleared">
                <header>
                    <button name="action_unlock" type="object" string="Unlock" class="btn-secondary"/>
                </header>
                <field name="create_date" string="Time"/>
                <field name="config_id"/>
                <field name="session_id" optional="show"/>
                <field name="action"/>
                <field name="employee_id"/>
                <field name="cashier_id" optional="show"/>
                <field name="create_uid" string="User" optional="hide"/>
                <field name="origin" optional="show"/>
                <field name="reference" optional="hide"/>
                <field name="success" widget="boolean"/>
                <field name="cleared" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="pos_manager_validation_view_search" model="ir.ui.view">
        <field name="name">pos.manager.validation.search</field>
        <field name="model">pos.manager.validation</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="reference"/>
                <filter name="failed" string="Wrong PIN" domain="[('success', '=', False)]"/>
                <filter name="validated" string="Validated" domain="[('success', '=', True)]"/>
                <separator/>
                <filter name="today" string="Today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_employee" string="Manager" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_manager_validation" model="ir.actions.act_window">
        <field name="name">Manager Validations</field>
        <field name="res_model">pos.manager.validation</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No manager validation yet</p>
            <p>Every manager PIN request from the point of sale and the backend is logged here, without the PIN.</p>
        </field>
    </record>

    <menuitem id="menu_pos_manager_validation" name="Manager Validations" action="action_pos_manager_validation"
              parent="point_of_sale.menu_point_rep" sequence="40" groups="point_of_sale.group_pos_manager"/>
</odoo>
