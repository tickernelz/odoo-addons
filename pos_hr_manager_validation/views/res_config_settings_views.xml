<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_hr_manager_validation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='multiple_employee_session']" position="after">
                <setting id="manager_validation" string="Manager Validation"
                         help="Ticked actions on this point of sale wait for the POS validation PIN of one of these managers"
                         invisible="not pos_module_pos_hr">
                    <div class="content-group mt16">
                        <div class="row">
                            <label for="pos_mv_employee_ids" string="Managers" class="col-lg-4 o_light_label"/>
                            <field name="pos_mv_employee_ids" widget="many2many_tags" placeholder="Select Employee(s)"
                                   domain="[('company_id', 'in', [company_id, False])]"/>
                        </div>
                        <div class="row mt8" invisible="not pos_mv_employee_ids">
                            <div class="col-lg-6">
                                <div class="o_mv_action"><field name="pos_mv_close_session" class="w-auto me-2"/><label for="pos_mv_close_session" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_delete_order" class="w-auto me-2"/><label for="pos_mv_delete_order" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_delete_line" class="w-auto me-2"/><label for="pos_mv_delete_line" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_payment" class="w-auto me-2"/><label for="pos_mv_payment" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_discount" class="w-auto me-2"/><label for="pos_mv_discount" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_price" class="w-auto me-2"/><label for="pos_mv_price" class="o_light_label"/></div>
                            </div>
                            <div class="col-lg-6">
                                <div class="o_mv_action"><field name="pos_mv_decrease_qty" class="w-auto me-2"/><label for="pos_mv_decrease_qty" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_cash_move" class="w-auto me-2"/><label for="pos_mv_cash_move" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_create_product" class="w-auto me-2"/><label for="pos_mv_create_product" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_fiscal_position" class="w-auto me-2"/><label for="pos_mv_fiscal_position" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_pricelist" class="w-auto me-2"/><label for="pos_mv_pricelist" class="o_light_label"/></div>
                                <div class="o_mv_action"><field name="pos_mv_refund" class="w-auto me-2"/><label for="pos_mv_refund" class="o_light_label"/></div>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
