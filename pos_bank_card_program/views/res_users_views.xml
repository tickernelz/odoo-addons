<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_bank_card_pin" model="ir.ui.view">
        <field name="name">res.users.form.bank.card.pin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='lang']" position="after">
                <field name="bank_card_manager_pin" password="True"
                       groups="pos_bank_card_program.group_bank_card_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
