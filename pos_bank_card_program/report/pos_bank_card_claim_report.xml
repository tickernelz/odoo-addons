<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_bank_card_claim">
        <t t-call="web.html_container">
            <t t-call="pos_bank_card_program.report_bank_card_claim_document"/>
        </t>
    </template>

    <template id="report_bank_card_claim_wizard">
        <t t-call="web.html_container">
            <t t-call="pos_bank_card_program.report_bank_card_claim_document"/>
        </t>
    </template>

    <template id="report_bank_card_claim_document">
            <t t-foreach="docs" t-as="doc">
                <t t-set="data" t-value="doc._claim_pdf_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Bank Card Claim</h2>
                        <table class="table table-borderless table-sm w-50">
                            <tbody>
                                <tr>
                                    <td><strong>Company</strong></td>
                                    <td><t t-esc="data['company']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Bank</strong></td>
                                    <td><t t-esc="data['bank']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Programme</strong></td>
                                    <td><t t-esc="data['program']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Period</strong></td>
                                    <td><t t-esc="data['date_from_label']"/> - <t t-esc="data['date_to_label']"/></td>
                                </tr>
                                <tr t-if="data['number']">
                                    <td><strong>Claim Number</strong></td>
                                    <td><t t-esc="data['number']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Printed On</strong></td>
                                    <td><t t-esc="data['printed_at_label']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <h3>Summary by Outlet</h3>
                        <table class="table table-sm o_main_table table-borderless">
                            <thead>
                                <tr>
                                    <th>Outlet</th>
                                    <th class="text-end">Usage Lines</th>
                                    <th class="text-end">Basis</th>
                                    <th class="text-end">Discount</th>
                                    <th class="text-end">Bank Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['summary']" t-as="line">
                                    <td><t t-esc="line['outlet']"/></td>
                                    <td class="text-end"><t t-esc="line['usage_count']"/></td>
                                    <td class="text-end"><span t-esc="line['basis_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></td>
                                    <td class="text-end"><span t-esc="line['discount_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></td>
                                    <td class="text-end"><span t-esc="line['bank_share_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Total</strong></td>
                                    <td class="text-end"><strong><t t-esc="data['usage_count']"/></strong></td>
                                    <td class="text-end"><strong><span t-esc="data['totals']['basis_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></strong></td>
                                    <td class="text-end"><strong><span t-esc="data['totals']['discount_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></strong></td>
                                    <td class="text-end"><strong><span t-esc="data['totals']['bank_share_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></strong></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="page">
                        <h3>Transaction Details</h3>
                        <table class="table table-sm o_main_table table-borderless">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Outlet</th>
                                    <th>Card</th>
                                    <th>Approval Code</th>
                                    <th class="text-end">Basis</th>
                                    <th class="text-end">Discount</th>
                                    <th class="text-end">Bank Share</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['details']" t-as="row">
                                    <td><t t-esc="row['date_label']"/></td>
                                    <td><t t-esc="row['outlet']"/></td>
                                    <td><t t-esc="row['masked_card']"/></td>
                                    <td><t t-esc="row['approval_code']"/></td>
                                    <td class="text-end"><span t-esc="row['basis_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></td>
                                    <td class="text-end"><span t-esc="row['discount_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></td>
                                    <td class="text-end"><span t-esc="row['bank_share_amount']" t-options="{'widget': 'float', 'precision': data['precision']}"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
    </template>

    <record id="action_report_bank_card_claim" model="ir.actions.report">
        <field name="name">Bank Card Claim</field>
        <field name="model">pos.bank.card.claim</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_bank_card_program.report_bank_card_claim</field>
        <field name="report_file">pos_bank_card_program.report_bank_card_claim</field>
        <field name="print_report_name">'Claim - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="group_ids" eval="[(4, ref('pos_bank_card_program.group_bank_card_finance'))]"/>
    </record>

    <record id="action_report_bank_card_claim_wizard" model="ir.actions.report">
        <field name="name">Bank Card Claim Preview</field>
        <field name="model">pos.bank.card.claim.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_bank_card_program.report_bank_card_claim_wizard</field>
        <field name="report_file">pos_bank_card_program.report_bank_card_claim_wizard</field>
        <field name="print_report_name">'Claim - %s - %s to %s' % (object.bank_id.name or '', object.date_from or '', object.date_to or '')</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
        <field name="group_ids" eval="[(4, ref('pos_bank_card_program.group_bank_card_finance'))]"/>
    </record>
</odoo>
