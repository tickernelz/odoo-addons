<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_bank_card_claim_wizard_form" model="ir.ui.view">
        <field name="name">pos.bank.card.claim.wizard.form</field>
        <field name="model">pos.bank.card.claim.wizard</field>
        <field name="arch" type="xml">
            <form string="Claim to Bank">
                <group>
                    <field name="state" invisible="1"/>
                    <field name="bank_id" readonly="state == 'preview'"/>
                    <field name="program_id" readonly="state == 'preview'"/>
                    <field name="date_from" readonly="state == 'preview'"/>
                    <field name="date_to" readonly="state == 'preview'"/>
                    <field name="company_id" groups="base.group_multi_company" readonly="state == 'preview'"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <group string="Per Outlet" invisible="state != 'preview'">
                    <field name="line_ids" readonly="1" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="config_id" string="Outlet"/>
                            <field name="usage_count" sum="Usage Lines"/>
                            <field name="basis_amount" sum="Basis"/>
                            <field name="discount_amount" sum="Discount"/>
                            <field name="bank_share_amount" sum="Bank Share"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <field name="usage_count"/>
                    <field name="total_basis_amount"/>
                    <field name="total_discount_amount"/>
                    <field name="total_bank_share_amount"/>
                </group>
                <footer>
                    <button name="action_preview" string="Preview" type="object"
                            class="btn-primary" invisible="state != 'select'"/>
                    <button name="action_create_claim" string="Create Claim" type="object"
                            class="btn-primary" invisible="state != 'preview'"/>
                    <button name="action_print_pdf" string="Print PDF" type="object"
                            groups="pos_bank_card_program.group_bank_card_finance"
                            invisible="state != 'preview'"/>
                    <button name="action_back" string="Back" type="object"
                            invisible="state != 'preview'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_bank_card_claim_wizard" model="ir.actions.act_window">
        <field name="name">Claim to Bank</field>
        <field name="res_model">pos.bank.card.claim.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_pos_bank_card_claim_wizard_form"/>
    </record>
</odoo>
