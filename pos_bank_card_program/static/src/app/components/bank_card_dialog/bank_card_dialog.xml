<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_bank_card_program.BankCardDialog">
        <Dialog title.translate="Bank Card Programme" size="'md'">
            <div class="o-bank-card-dialog d-flex flex-column gap-3">
                <div>
                    <label class="form-label" for="bank-card-bin">Card Prefix (6-8 digits)</label>
                    <input id="bank-card-bin" class="form-control o-bank-card-input" type="text"
                           inputmode="numeric" autocomplete="off" maxlength="8"
                           t-att-value="state.cardBin"
                           t-on-input="(event) => this.onInput('cardBin', event)"/>
                </div>
                <div class="d-flex flex-wrap gap-1" t-if="detection.binRange">
                    <span class="badge text-bg-secondary o-bank-card-chip" t-if="detection.binRange.network">
                        <t t-esc="detection.binRange.network"/>
                    </span>
                    <span class="badge text-bg-secondary o-bank-card-chip" t-if="cardTypeLabel">
                        <t t-esc="cardTypeLabel"/>
                    </span>
                    <span class="badge text-bg-secondary o-bank-card-chip" t-if="detection.binRange.tier">
                        <t t-esc="detection.binRange.tier"/>
                    </span>
                    <span class="badge text-bg-primary o-bank-card-chip" t-if="program">
                        <t t-esc="program.name"/>
                    </span>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label" for="bank-card-last4">Last 4 Digits</label>
                        <input id="bank-card-last4" class="form-control o-bank-card-input" type="text"
                               inputmode="numeric" autocomplete="off" maxlength="4"
                               t-att-value="state.cardLast4"
                               t-on-input="(event) => this.onInput('cardLast4', event)"/>
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="bank-card-approval">Approval Code</label>
                        <input id="bank-card-approval" class="form-control o-bank-card-input" type="text"
                               autocomplete="off" maxlength="12"
                               t-att-value="state.approvalCode"
                               t-on-input="onApprovalInput"/>
                    </div>
                </div>
                <div t-att-class="detection.eligible and !state.serverMessage ? 'alert alert-success mb-0' : 'alert alert-warning mb-0'"
                     role="status">
                    <i t-att-class="detection.eligible and !state.serverMessage ? 'fa fa-check-circle me-1' : 'fa fa-exclamation-triangle me-1'"/>
                    <span t-esc="resultMessage"/>
                    <span t-if="detection.eligible and !state.serverMessage" class="d-block">
                        Discount: <span class="fw-bold" t-esc="env.utils.formatCurrency(detection.discount_amount)"/>
                    </span>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary o-bank-card-button" t-att-disabled="!canApply"
                        t-on-click="apply">
                    Apply Discount
                </button>
                <button class="btn btn-secondary o-bank-card-button" t-on-click="skip">
                    Continue Without Discount
                </button>
            </t>
        </Dialog>
    </t>
</templates>
