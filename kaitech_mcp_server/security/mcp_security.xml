<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            mcp.token record rules
            ─────────────────────
            group_user  → sees ONLY own tokens (user_id = uid)
            group_system → sees ALL tokens (ORed with group_user rule = admin wins)
        -->
        <record id="rule_mcp_token_user_own" model="ir.rule">
            <field name="name">MCP Token: users see own tokens only</field>
            <field name="model_id" ref="model_mcp_token"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_mcp_token_admin_all" model="ir.rule">
            <field name="name">MCP Token: admin sees all</field>
            <field name="model_id" ref="model_mcp_token"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!--
            mcp.session record rules
            ────────────────────────
            group_user  → sees ONLY own sessions (read-only)
            group_system → sees ALL sessions (full access)
