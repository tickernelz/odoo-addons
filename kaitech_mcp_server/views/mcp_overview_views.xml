<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_overview_form" model="ir.ui.view">
        <field name="name">kaitech.mcp.overview.form</field>
        <field name="model">kaitech.mcp.overview</field>
        <field name="arch" type="xml">
            <form string="MCP Overview" create="false" edit="false" delete="false">
                <header>
                    <button name="action_test_endpoint" type="object" string="Test endpoint" class="oe_highlight"/>
                    <button name="%(action_mcp_key_wizard)d" type="action" string="Create key"/>
                </header>
                <div class="alert alert-warning" role="alert" attrs="{'invisible': [('server_wide', '=', True)]}">
                    <strong>The MCP endpoint is switched off on this server.</strong>
                    MCP clients do not send an Odoo session, so the module must be loaded server-wide.
                    Add this line to the [options] section of odoo.conf, then restart Odoo:
                    <field name="config_line" widget="mcp_copy"/>
                </div>
                <sheet>
                    <field name="server_wide" invisible="1"/>
                    <group>
                        <field name="endpoint_url" widget="mcp_copy"/>
                    </group>
                    <div class="o_mcp_tiles">
                        <button name="%(action_mcp_key)d" type="action" class="o_mcp_tile btn btn-default">
                            <span class="o_mcp_tile_value"><field name="active_keys"/></span>
                            <span>Active keys</span>
                        </button>
                        <button name="%(action_mcp_call)d" type="action" class="o_mcp_tile btn btn-default"
                                context="{'search_default_today': 1}">
                            <span class="o_mcp_tile_value"><field name="calls_24h"/></span>
                            <span>Calls in 24 h</span>
                        </button>
                        <button name="%(action_mcp_call)d" type="action" class="o_mcp_tile btn btn-default"
                                context="{'search_default_today': 1, 'search_default_refused': 1, 'search_default_limited': 1}">
                            <span class="o_mcp_tile_value"><field name="refused_24h"/></span>
                            <span>Refused or limited</span>
                        </button>
                        <button name="%(action_mcp_call)d" type="action" class="o_mcp_tile btn btn-default"
                                context="{'search_default_today': 1, 'search_default_errors': 1}">
                            <span class="o_mcp_tile_value"><field name="errors_24h"/></span>
                            <span>Errors</span>
                        </button>
                    </div>
                    <group string="Last endpoint test">
                        <field name="last_test_result"/>
                        <field name="last_test_detail"/>
                        <field name="last_test_at"/>
                    </group>
                    <separator string="Databases on this server"/>
                    <p class="text-muted">An MCP client picks its database by the address it calls: /mcp/ followed by
                        the database name. Each database has its own keys and call log.</p>
                    <field name="databases_hidden" invisible="1"/>
                    <p class="text-muted" attrs="{'invisible': [('databases_hidden', '=', False)]}">
                        This server hides its database list (list_db = False); only this database's endpoint is shown above.</p>
                    <field name="database_ids" attrs="{'invisible': [('databases_hidden', '=', True)]}">
                        <tree decoration-bf="current">
                            <field name="current" invisible="1"/>
                            <field name="name"/>
                            <field name="installed"/>
                            <field name="endpoint_url"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_overview" model="ir.actions.server">
        <field name="name">MCP Overview</field>
        <field name="model_id" ref="model_kaitech_mcp_overview"/>
        <field name="state">code</field>
        <field name="code">action = env['kaitech.mcp.overview'].action_open()</field>
    </record>
</odoo>
