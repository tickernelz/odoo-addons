<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_mcp_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'kaitech_mcp_server', 'bin_size': False}</field>
    </record>

    <menuitem id="mcp_menu_root"
              name="MCP Server"
              sequence="90"
              web_icon="kaitech_mcp_server,static/description/icon.png"
              groups="base.group_user"/>

    <menuitem id="mcp_menu_management"
              name="Management"
              parent="mcp_menu_root"
              groups="base.group_user"
              sequence="8"/>

    <menuitem id="mcp_menu_tokens"
              name="Tokens"
              parent="mcp_menu_management"
              action="mcp_token_action"
              sequence="4"/>

    <menuitem id="mcp_menu_sessions"
              name="Sessions"
              parent="mcp_menu_management"
              action="mcp_session_action"
              groups="base.group_system"
              sequence="8"/>

    <menuitem id="mcp_menu_tools"
              name="Tools"
              parent="mcp_menu_root"
              groups="base.group_user"
              sequence="12"/>

    <menuitem id="mcp_menu_jobs"
              name="Jobs"
              parent="mcp_menu_tools"
              action="mcp_job_action"
              sequence="4"/>

    <menuitem id="mcp_menu_portal_pages"
              name="Portal Pages"
              parent="mcp_menu_tools"
              action="mcp_portal_page_action"
              sequence="8"/>

    <menuitem id="mcp_menu_html_artifacts"
              name="HTML Artifacts"
              parent="mcp_menu_tools"
              action="mcp_html_artifact_action"
              sequence="10"/>

    <menuitem id="mcp_menu_generated_modules"
              name="Generated Modules"
              parent="mcp_menu_tools"
              action="mcp_generated_module_action"
              groups="base.group_system"
              sequence="12"/>

    <menuitem id="mcp_menu_configuration"
              name="Configuration"
              parent="mcp_menu_root"
              groups="base.group_user"
              sequence="99"/>

    <menuitem id="mcp_menu_settings"
              name="Settings"
              parent="mcp_menu_configuration"
              action="action_mcp_settings"
              groups="base.group_system"
              sequence="1"/>

</odoo>
