<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_key_tree" model="ir.ui.view">
        <field name="name">kaitech.mcp.key.tree</field>
        <field name="model">kaitech.mcp.key</field>
        <field name="arch" type="xml">
            <tree string="MCP Keys" create="false" decoration-muted="state in ('revoked', 'expired')" decoration-warning="state == 'expiring'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_index" string="Starts with"/>
                <field name="model_count"/>
                <field name="can_delete"/>
                <field name="allow_sql"/>
                <field name="allow_explore"/>
                <field name="allow_methods"/>
                <field name="rate_per_minute"/>
                <field name="expires_at"/>
                <field name="last_used_at"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_mcp_key_form" model="ir.ui.view">
        <field name="name">kaitech.mcp.key.form</field>
        <field name="model">kaitech.mcp.key</field>
        <field name="arch" type="xml">
            <form string="MCP Key" create="false">
                <header>
                    <button name="action_test_key" type="object" string="Test key" class="oe_highlight"
                            attrs="{'invisible': [('state', 'in', ('revoked', 'expired'))]}"/>
                    <button name="action_rotate" type="object" string="Rotate key"
                            attrs="{'invisible': [('revoked_at', '!=', False)]}"
                            confirm="A new key with the same permissions is created and this key stops working now. Continue?"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            attrs="{'invisible': [('revoked_at', '!=', False)]}"
                            confirm="The client using this key loses access immediately. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expiring,expired,revoked"/>
                </header>
                <div class="alert alert-warning" role="alert"
                     attrs="{'invisible': ['|', '|', ('model_count', '!=', 0), ('allow_explore', '=', True), ('state', 'in', ('revoked', 'expired'))]}">
                    This key cannot do anything yet: add at least one model on the Models tab or one table on the SQL tab.
                </div>
                <div class="alert alert-warning" role="alert" attrs="{'invisible': [('state', '!=', 'expiring')]}">
                    This key expires within 7 days. Rotate it or move its expiry date.
                </div>
                <div class="alert alert-info" role="alert" attrs="{'invisible': [('state', '!=', 'revoked')]}">
                    This key is revoked: every call with it is refused with HTTP 401.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_calls" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="calls_24h" widget="statinfo" string="Calls (24 h)"/>
                        </button>
                        <button name="action_open_calls" type="object" class="oe_stat_button" icon="fa-ban">
                            <field name="refused_24h" widget="statinfo" string="Refused (24 h)"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Alice - Claude Desktop"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="key_index" string="Key starts with"/>
                            <field name="expires_at"/>
                            <field name="last_used_at"/>
                        </group>
                        <group>
                            <field name="endpoint_url" widget="mcp_copy"/>
                            <field name="revoked_at" attrs="{'invisible': [('revoked_at', '=', False)]}"/>
                            <field name="revoked_by" attrs="{'invisible': [('revoked_at', '=', False)]}"/>
                            <field name="rotated_from_id" attrs="{'invisible': [('rotated_from_id', '=', False)]}"/>
                            <field name="model_count" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models" name="models">
                            <p class="text-muted">
                                The key can do something only when both this list and the Odoo access rights of its user allow it.
                                Never available: technical models (ir.*, base.*, bus.*), users and groups, the MCP models
                                themselves, password and token fields, and binary fields.
                            </p>
                            <field name="permission_ids">
                                <tree editable="bottom">
                                    <field name="model_id" options="{'no_create': True}"/>
                                    <field name="model_name"/>
                                    <field name="can_read"/>
                                    <field name="can_create"/>
                                    <field name="can_update"/>
                                    <field name="delete_enabled" invisible="1"/>
                                    <field name="can_delete" attrs="{'readonly': [('delete_enabled', '=', False)]}"/>
                                    <field name="methods_allowed" invisible="1"/>
                                    <field name="can_call" attrs="{'readonly': [('methods_allowed', '=', False)]}"/>
                                    <field name="field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="access_warning"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Code and methods" name="code">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="panel panel-default">
                                        <div class="panel-heading"><strong>Explore code</strong></div>
                                        <div class="panel-body">
                                            <group><field name="allow_explore"/></group>
                                            <p class="text-muted">
                                                The client can learn how this database works on its own: models, fields,
                                                methods and their overrides per module, views, menus and actions, and the
                                                source files of the installed modules. No records are read this way, and
                                                no file outside the addons folders.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="panel panel-default">
                                        <div class="panel-heading"><strong>Call methods</strong></div>
                                        <div class="panel-body">
                                            <group><field name="allow_methods"/></group>
                                            <p class="text-muted">
                                                The client can run public business methods, such as confirming an order, on
                                                the models ticked Call methods on the Models tab. They run as the user of
                                                this key, so its access rights and record rules apply. Private methods and
                                                write, unlink and the other ORM methods are always refused. A dry run
                                                executes the method and undoes every database change.
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </page>
                        <page string="SQL" name="sql">
                            <field name="sql_enabled" invisible="1"/>
                            <div class="alert alert-warning" role="alert">
                                SQL runs as the database itself: it bypasses Odoo access rights, record rules, constraints,
                                computed fields and tracking. Tick only the tables this client truly needs. Updates and deletes
                                need a where condition and change at most 20 rows per call; every statement is in the call log.
                            </div>
                            <p class="text-muted" attrs="{'invisible': [('sql_enabled', '=', True)]}">
                                SQL is switched off in MCP Settings, so Allow SQL cannot be ticked.</p>
                            <group>
                                <field name="allow_sql" attrs="{'readonly': [('sql_enabled', '=', False)]}"/>
                            </group>
                            <field name="sql_table_ids" attrs="{'invisible': [('allow_sql', '=', False)]}">
                                <tree editable="bottom">
                                    <field name="table_name"/>
                                    <field name="can_select"/>
                                    <field name="can_insert"/>
                                    <field name="can_update"/>
                                    <field name="delete_enabled" invisible="1"/>
                                    <field name="can_delete" attrs="{'readonly': [('delete_enabled', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Limits" name="limits">
                            <group>
                                <group string="Per minute">
                                    <field name="rate_per_minute"/>
                                    <field name="writes_per_minute"/>
                                </group>
                                <group string="Per call">
                                    <field name="max_read"/>
                                    <field name="max_write"/>
                                    <field name="max_delete"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_key_search" model="ir.ui.view">
        <field name="name">kaitech.mcp.key.search</field>
        <field name="model">kaitech.mcp.key</field>
        <field name="arch" type="xml">
            <search string="MCP Keys">
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_index"/>
                <filter name="usable" string="Usable" domain="[('state', 'in', ('active', 'expiring'))]"/>
                <filter name="expiring" string="Expiring soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_key" model="ir.actions.act_window">
        <field name="name">MCP Keys</field>
        <field name="res_model">kaitech.mcp.key</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_usable': 1}</field>
        <field name="help" type="html">
            <p><b>No MCP keys in this database yet.</b></p>
            <p>A key lets one MCP client (Claude Desktop, Cursor, n8n, ...) work in this database as one Odoo user,
               limited to the models and actions you tick. Use MCP Server, Create key to make the first one.</p>
        </field>
    </record>
</odoo>
