<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view -->
    <record id="mcp_generated_module_list_view" model="ir.ui.view">
        <field name="name">mcp.generated.module.list</field>
        <field name="model">mcp.generated.module</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'installed'"
                  decoration-info="state == 'generated'"
                  decoration-muted="state == 'draft'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="version"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'installed'"
                       decoration-info="state == 'generated'"
                       decoration-muted="state == 'draft'"
                       decoration-danger="state == 'failed'"/>
                <field name="created_by"/>
                <field name="create_date" string="Created On"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="mcp_generated_module_form_view" model="ir.ui.view">
        <field name="name">mcp.generated.module.form</field>
        <field name="model">mcp.generated.module</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate"
                            string="Generate ZIP"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('draft', 'failed')"/>
                    <button name="action_download"
                            string="Download ZIP"
                            type="object"
                            invisible="state != 'generated'"/>
                    <button name="action_install"
                            string="Install on This Instance"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'generated'"
                            confirm="This will extract the module ZIP to the configured addons path and install it. The Odoo registry will be restarted. Proceed?"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('generated', 'failed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,generated,installed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Module Display Name"/>
                        </h1>
                        <h3>
                            <field name="technical_name" placeholder="technical_name"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Module Metadata">
                            <field name="summary"/>
                            <field name="category"/>
                            <field name="author"/>
                            <field name="version"/>
                            <field name="license"/>
                            <field name="depends"/>
                        </group>
                        <group string="Generation Info">
                            <field name="created_by"/>
                            <field name="create_date" string="Created On"/>
                            <field name="installed_at"
                                   invisible="state != 'installed'"/>
                            <field name="attachment_id"
                                   invisible="not attachment_id"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Spec (JSON)" name="spec">
                            <field name="spec"
                                   widget="ace"
                                   options="{'mode': 'javascript'}"
                                   nolabel="1"/>
                        </page>
                        <page string="Generation Log" name="generation_log">
                            <field name="generation_log"
                                   readonly="1"
                                   nolabel="1"
                                   placeholder="Log output will appear here after generation."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="mcp_generated_module_search_view" model="ir.ui.view">
        <field name="name">mcp.generated.module.search</field>
        <field name="model">mcp.generated.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="created_by"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Generated" name="filter_generated"
                        domain="[('state', '=', 'generated')]"/>
                <filter string="Installed" name="filter_installed"
                        domain="[('state', '=', 'installed')]"/>
                <filter string="Failed" name="filter_failed"
                        domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter string="My Modules" name="filter_mine"
                        domain="[('created_by', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="mcp_generated_module_action" model="ir.actions.act_window">
        <field name="name">Generated Modules</field>
        <field name="res_model">mcp.generated.module</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="mcp_generated_module_search_view"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No generated modules yet.
            </p>
            <p>
                Use the <b>odoo_generate_module</b> MCP tool (admin scope required)
                to generate an installable Odoo module from a JSON specification.
            </p>
        </field>
    </record>

</odoo>
