<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pos_xendit_qris</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="xendit_qris_secret_key" password="True"
                    invisible="use_payment_terminal != 'xendit_qris'"
                    required="use_payment_terminal == 'xendit_qris'"/>
                <field name="xendit_qris_webhook_token" password="True"
                    invisible="use_payment_terminal != 'xendit_qris'"
                    required="use_payment_terminal == 'xendit_qris'"/>
                <field name="xendit_qris_expiry_minutes"
                    invisible="use_payment_terminal != 'xendit_qris'"/>
                <field name="xendit_qris_webhook_url" widget="CopyClipboardChar"
                    invisible="use_payment_terminal != 'xendit_qris'"/>
            </xpath>
            <xpath expr="//field[@name='split_transactions']" position="after">
                <field name="create_statement_memo" invisible="type == 'pay_later'"/>
                <field name="statement_memo_partner_id" invisible="not split_transactions"/>
            </xpath>
        </field>
    </record>
</odoo>
