<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_xendit_qris_request_view_list" model="ir.ui.view">
        <field name="name">pos.xendit.qris.request.list</field>
        <field name="model">pos.xendit.qris.request</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-danger="attention" decoration-success="state == 'paid'">
                <field name="create_date" string="Created"/>
                <field name="reference_id"/>
                <field name="config_id"/>
                <field name="session_id"/>
                <field name="payment_method_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state"/>
                <field name="paid_at"/>
                <field name="payment_request_id" optional="hide"/>
                <field name="payment_id" optional="hide"/>
                <field name="attention" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="pos_xendit_qris_request_view_form" model="ir.ui.view">
        <field name="name">pos.xendit.qris.request.form</field>
        <field name="model">pos.xendit.qris.request</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="reference_id"/></h1></div>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="payment_method_id"/>
                            <field name="order_reference"/>
                            <field name="pos_payment_id"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="expires_at"/>
                            <field name="paid_at"/>
                            <field name="payment_request_id"/>
                            <field name="payment_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="attention" invisible="not attention" class="text-danger"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_xendit_qris_request_view_search" model="ir.ui.view">
        <field name="name">pos.xendit.qris.request.search</field>
        <field name="model">pos.xendit.qris.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference_id"/>
                <field name="payment_request_id"/>
                <field name="payment_id"/>
                <field name="session_id"/>
                <filter name="needs_attention" string="Needs attention" domain="[('attention', '!=', False)]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_pos_xendit_qris_request" model="ir.actions.act_window">
        <field name="name">QRIS Xendit</field>
        <field name="res_model">pos.xendit.qris.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pos_xendit_qris_request" name="QRIS Xendit"
        parent="point_of_sale.menu_point_of_sale" action="action_pos_xendit_qris_request"
        groups="point_of_sale.group_pos_manager" sequence="40"/>
</odoo>
