<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP Server</field>
        <field name="sequence">90</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_mcp_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp"/>
        <field name="comment">Reads MCP keys and the MCP call log.</field>
    </record>

    <record id="group_mcp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_mcp_auditor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Creates, revokes and rotates MCP keys, sets their permissions and the MCP settings.</field>
    </record>

    <record id="rule_mcp_key_wizard_own" model="ir.rule">
        <field name="name">MCP key wizard: own records</field>
        <field name="model_id" ref="model_kaitech_mcp_key_wizard"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_mcp_key_test_own" model="ir.rule">
        <field name="name">MCP key test: own records</field>
        <field name="model_id" ref="model_kaitech_mcp_key_test"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
</odoo>
