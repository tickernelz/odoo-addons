<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_key_list" model="ir.ui.view">
        <field name="name">kaitech.mcp.key.list</field>
        <field name="model">kaitech.mcp.key</field>
        <field name="arch" type="xml">
            <list string="MCP Keys" create="false" decoration-muted="state in ('revoked', 'expired')" decoration-warning="state == 'expiring'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_index" string="Starts with"/>
                <field name="model_count"/>
                <field name="can_delete"/>
                <field name="allow_sql"/>
                <field name="allow_explore" optional="show"/>
                <field name="allow_call" optional="show"/>
                <field name="rate_per_minute" optional="hide"/>
                <field name="expires_at"/>
                <field name="last_used_at"/>
                <field name="state" widget="badge" decoration-success="state == 'active'" decoration-warning="state == 'expiring'" decoration-danger="state in ('revoked', 'expired')"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_key_form" model="ir.ui.view">
        <field name="name">kaitech.mcp.key.form</field>
        <field name="model">kaitech.mcp.key</field>
        <field name="arch" type="xml">
            <form string="MCP Key" create="false">
                <header>
                    <button name="action_test_key" type="object" string="Test key" class="oe_highlight"
                            invisible="state in ('revoked', 'expired')" groups="kaitech_mcp.group_mcp_manager"/>
                    <button name="action_rotate" type="object" string="Rotate key" invisible="revoked_at"
                            groups="kaitech_mcp.group_mcp_manager"
                            confirm="A new key with the same permissions is created and this key stops working now. Continue?"/>
                    <button name="action_revoke" type="object" string="Revoke" invisible="revoked_at"
                            groups="kaitech_mcp.group_mcp_manager"
                            confirm="The client using this key loses access immediately. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,expiring,expired,revoked"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="model_count or state in ('revoked', 'expired')">
                    This key cannot do anything yet: add at least one model on the Models tab or one table on the SQL tab.
                </div>
                <div class="alert alert-warning mb-0" role="alert" invisible="state != 'expiring'">
                    This key expires within 7 days. Rotate it or move its expiry date.
                </div>
                <div class="alert alert-info mb-0" role="alert" invisible="state != 'revoked'">
                    This key is revoked: every call with it is refused with HTTP 401.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_calls" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="calls_24h" widget="statinfo" string="Calls (24 h)"/>
                        </button>
                        <button name="action_open_calls" type="object" class="oe_stat_button" icon="fa-ban">
                            <field name="refused_24h" widget="statinfo" string="Refused (24 h)"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Finance - Claude Desktop"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="key_index" string="Key starts with"/>
                            <field name="expires_at"/>
                            <field name="last_used_at"/>
                        </group>
                        <group>
                            <field name="endpoint_url" widget="CopyClipboardChar"/>
                            <field name="revoked_at" invisible="not revoked_at"/>
                            <field name="revoked_by" invisible="not revoked_at"/>
                            <field name="rotated_from_id" invisible="not rotated_from_id"/>
                            <field name="model_count" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Models" name="models">
                            <p class="text-muted">
                                The key can do something only when both this list and the Odoo access rights of its user allow it.
                                Never available: technical models (ir.*, base.*, bus.*), users and groups, the MCP models
                                themselves, password and token fields, and binary fields.
                            </p>
                            <group name="agent_tools">
                                <group>
                                    <field name="allow_explore" widget="boolean_toggle"/>
                                    <div colspan="2" class="text-muted">Models, fields, methods, source code, views and
                                        menus of the installed modules. Never records or files outside the module folders.</div>
                                </group>
                                <group>
                                    <field name="allow_call" widget="boolean_toggle"/>
                                    <div colspan="2" class="text-muted">Public business methods of the models ticked in the
                                        Call column, as the key's user. dry_run lets the client try a call and undo it.</div>
                                </group>
                            </group>
                            <field name="permission_ids">
                                <list editable="bottom">
                                    <field name="model_id" options="{'no_create': True}"/>
                                    <field name="model_name"/>
                                    <field name="can_read"/>
                                    <field name="can_create"/>
                                    <field name="can_update"/>
                                    <field name="delete_enabled" column_invisible="1"/>
                                    <field name="can_delete" readonly="not delete_enabled"/>
                                    <field name="can_call" column_invisible="not parent.allow_call"/>
                                    <field name="field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="access_warning" decoration-warning="access_warning"/>
                                </list>
                            </field>
                        </page>
                        <page string="SQL" name="sql">
                            <field name="sql_enabled" invisible="1"/>
                            <div class="alert alert-warning" role="alert">
                                SQL runs as the database itself: it bypasses Odoo access rights, record rules, Python constraints,
                                computed fields and chatter tracking. Tick only the tables this client truly needs. Updates and
                                deletes need a where condition and change at most 20 rows per call; every statement is in the call log.
                            </div>
                            <p class="text-muted" invisible="sql_enabled">
                                SQL is switched off in MCP Settings, so Allow SQL cannot be ticked.
                            </p>
                            <group>
                                <field name="allow_sql" readonly="not sql_enabled"/>
                            </group>
                            <field name="sql_table_ids" invisible="not allow_sql">
                                <list editable="bottom">
                                    <field name="model_id" options="{'no_create': True}" optional="show"/>
                                    <field name="table_name"/>
                                    <field name="can_select"/>
                                    <field name="can_insert"/>
                                    <field name="can_update"/>
                                    <field name="delete_enabled" column_invisible="1"/>
                                    <field name="can_delete" readonly="not delete_enabled"/>
                                </list>
                            </field>
                        </page>
                        <page string="Limits" name="limits">
                            <group>
                                <group string="Per minute">
                                    <field name="rate_per_minute"/>
                                    <field name="writes_per_minute"/>
                                </group>
                                <group string="Per call">
                                    <field name="max_read"/>
                                    <field name="max_write"/>
                                    <field name="max_delete"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_key_search" model="ir.ui.view">
        <field name="name">kaitech.mcp.key.search</field>
        <field name="model">kaitech.mcp.key</field>
        <field name="arch" type="xml">
            <search string="MCP Keys">
                <field name="name"/>
                <field name="user_id"/>
                <field name="key_index"/>
                <filter name="usable" string="Usable" domain="[('state', 'in', ('active', 'expiring'))]"/>
                <filter name="expiring" string="Expiring soon" domain="[('state', '=', 'expiring')]"/>
                <filter name="revoked" string="Revoked" domain="[('state', '=', 'revoked')]"/>
                <filter name="expired" string="Expired" domain="[('state', '=', 'expired')]"/>
                <separator/>
                <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_mcp_key" model="ir.actions.act_window">
        <field name="name">MCP Keys</field>
        <field name="res_model">kaitech.mcp.key</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_usable': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No MCP keys in this database yet.</p>
            <p>A key lets one MCP client (Claude Desktop, Cursor, n8n, ...) work in this database as one Odoo user,
               limited to the models and actions you tick. Use Create key to make the first one.</p>
        </field>
    </record>
</odoo>
