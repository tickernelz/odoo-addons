<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_call_list" model="ir.ui.view">
        <field name="name">kaitech.mcp.call.list</field>
        <field name="model">kaitech.mcp.call</field>
        <field name="arch" type="xml">
            <list string="MCP Call Log" create="false" edit="false" delete="false"
                  decoration-danger="result == 'error'" decoration-warning="result in ('refused', 'limited')"
                  decoration-muted="result == 'invalid_arguments'">
                <field name="create_date"/>
                <field name="key_name"/>
                <field name="user_id"/>
                <field name="method"/>
                <field name="tool"/>
                <field name="model"/>
                <field name="record_count"/>
                <field name="result" widget="badge" decoration-success="result == 'ok'" decoration-warning="result in ('refused', 'limited')" decoration-danger="result == 'error'"/>
                <field name="reason"/>
                <field name="duration_ms" sum="Total"/>
                <field name="client_name" optional="show"/>
                <field name="remote_addr" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_call_form" model="ir.ui.view">
        <field name="name">kaitech.mcp.call.form</field>
        <field name="model">kaitech.mcp.call</field>
        <field name="arch" type="xml">
            <form string="MCP Call" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="key_id"/>
                            <field name="key_name"/>
                            <field name="user_id"/>
                            <field name="method"/>
                            <field name="tool"/>
                            <field name="result"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="record_ids"/>
                            <field name="record_count"/>
                            <field name="fields_written"/>
                            <field name="duration_ms"/>
                            <field name="client_name"/>
                            <field name="client_version"/>
                            <field name="remote_addr"/>
                            <field name="protocol_version"/>
                        </group>
                    </group>
                    <group string="SQL statement" invisible="not statement">
                        <field name="dry_run"/>
                        <field name="statement" nolabel="1" colspan="2" class="font-monospace"/>
                    </group>
                    <group string="Deleted records" invisible="not deleted_names">
                        <field name="deleted_names" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_call_search" model="ir.ui.view">
        <field name="name">kaitech.mcp.call.search</field>
        <field name="model">kaitech.mcp.call</field>
        <field name="arch" type="xml">
            <search string="MCP Call Log">
                <field name="key_name"/>
                <field name="key_id"/>
                <field name="tool"/>
                <field name="model"/>
                <field name="reason"/>
                <filter name="today" string="Last 24 hours"
                        domain="[('create_date', '>=', (datetime.datetime.now() - datetime.timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <separator/>
                <filter name="refused" string="Refused" domain="[('result', '=', 'refused')]"/>
                <filter name="limited" string="Rate limited" domain="[('result', '=', 'limited')]"/>
                <filter name="errors" string="Errors" domain="[('result', 'in', ('error', 'invalid_arguments'))]"/>
                <separator/>
                <filter name="writes" string="Writes" domain="[('is_write', '=', True)]"/>
                <filter name="deletes" string="Deletes" domain="[('tool', 'in', ('delete_records', 'sql_delete'))]"/>
                <filter name="sql" string="SQL" domain="[('tool', '=like', 'sql_%')]"/>
                <separator/>
                <filter name="group_key" string="Key" context="{'group_by': 'key_id'}"/>
                <filter name="group_tool" string="Tool" context="{'group_by': 'tool'}"/>
                <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                <filter name="group_result" string="Result" context="{'group_by': 'result'}"/>
                <filter name="group_day" string="Day" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="view_mcp_call_graph" model="ir.ui.view">
        <field name="name">kaitech.mcp.call.graph</field>
        <field name="model">kaitech.mcp.call</field>
        <field name="arch" type="xml">
            <graph string="MCP Calls" type="bar">
                <field name="create_date" interval="day" type="row"/>
                <field name="result" type="col"/>
            </graph>
        </field>
    </record>

    <record id="view_mcp_call_pivot" model="ir.ui.view">
        <field name="name">kaitech.mcp.call.pivot</field>
        <field name="model">kaitech.mcp.call</field>
        <field name="arch" type="xml">
            <pivot string="MCP Calls">
                <field name="key_name" type="row"/>
                <field name="result" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_mcp_call" model="ir.actions.act_window">
        <field name="name">MCP Call Log</field>
        <field name="res_model">kaitech.mcp.call</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No MCP calls yet.</p>
            <p>Install a client with a key from MCP Keys; its first call shows up here and in the key's Last used.
               If the client cannot connect, run Test endpoint on MCP Overview.</p>
        </field>
    </record>
</odoo>
