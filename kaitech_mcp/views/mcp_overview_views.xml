<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_overview_form" model="ir.ui.view">
        <field name="name">kaitech.mcp.overview.form</field>
        <field name="model">kaitech.mcp.overview</field>
        <field name="arch" type="xml">
            <form string="MCP Overview" create="false" edit="false" delete="false">
                <header>
                    <button name="action_test_endpoint" type="object" string="Test endpoint" class="oe_highlight"/>
                    <button name="action_new_key" type="object" string="Create key"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="server_wide">
                    <strong>The MCP endpoint is switched off on this server.</strong>
                    MCP clients do not send an Odoo session, so the module must be loaded server-wide.
                    Add this line to the [options] section of odoo.conf, then restart Odoo:
                    <field name="config_line" widget="CopyClipboardChar"/>
                </div>
                <sheet>
                    <div class="oe_title">
                        <h1>MCP Server</h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint_url" widget="CopyClipboardChar"/>
                            <field name="server_wide" string="Loaded server-wide" readonly="1"/>
                            <field name="delete_enabled" readonly="1"/>
                            <field name="sql_enabled" readonly="1"/>
                        </group>
                        <group>
                            <field name="database"/>
                            <field name="last_test_result" decoration-success="last_test_result == 'ok'" decoration-danger="last_test_result and last_test_result != 'ok'"/>
                            <field name="last_test_at" invisible="not last_test_at"/>
                            <field name="audit_retention_days"/>
                        </group>
                    </group>
                    <div class="row g-2 my-3">
                        <div class="col-6 col-md-3">
                            <button name="%(action_mcp_key)d" type="action" class="btn btn-light border w-100 py-3">
                                <div class="fs-2 fw-bold"><field name="active_keys"/></div>
                                <div class="text-muted">Active keys</div>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button name="%(action_mcp_call)d" type="action" class="btn btn-light border w-100 py-3"
                                    context="{'search_default_today': 1}">
                                <div class="fs-2 fw-bold"><field name="calls_24h"/></div>
                                <div class="text-muted">Calls in 24 h</div>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button name="%(action_mcp_call)d" type="action" class="btn btn-light border w-100 py-3"
                                    context="{'search_default_today': 1, 'search_default_refused': 1, 'search_default_limited': 1}">
                                <div class="fs-2 fw-bold text-warning"><field name="refused_24h"/></div>
                                <div class="text-muted">Refused or limited</div>
                            </button>
                        </div>
                        <div class="col-6 col-md-3">
                            <button name="%(action_mcp_call)d" type="action" class="btn btn-light border w-100 py-3"
                                    context="{'search_default_today': 1, 'search_default_errors': 1}">
                                <div class="fs-2 fw-bold text-danger"><field name="errors_24h"/></div>
                                <div class="text-muted">Errors</div>
                            </button>
                        </div>
                    </div>
                    <div class="alert alert-info" role="status">
                        Keys only work in this database. A key made in another database is always refused here (401).
                        <span invisible="not last_test_detail"><br/><field name="last_test_detail" class="d-inline"/></span>
                    </div>
                    <separator string="Databases on this server"/>
                    <p class="text-muted">An MCP client picks its database by the address it calls: /mcp/ followed by
                        the database name. Each database has its own keys and call log.</p>
                    <field name="databases_hidden" invisible="1"/>
                    <p class="text-muted" invisible="not databases_hidden">
                        This server hides its database list (list_db = False); only this database's endpoint is shown above.</p>
                    <field name="database_ids" invisible="databases_hidden">
                        <list decoration-bf="current">
                            <field name="current" column_invisible="1"/>
                            <field name="name"/>
                            <field name="installed"/>
                            <field name="endpoint_url"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_overview" model="ir.actions.server">
        <field name="name">MCP Overview</field>
        <field name="model_id" ref="model_kaitech_mcp_overview"/>
        <field name="group_ids" eval="[(4, ref('group_mcp_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['kaitech.mcp.overview'].action_open()</field>
    </record>
</odoo>
