<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_key_wizard_form" model="ir.ui.view">
        <field name="name">kaitech.mcp.key.wizard.form</field>
        <field name="model">kaitech.mcp.key.wizard</field>
        <field name="arch" type="xml">
            <form string="New MCP key">
                <field name="step" invisible="1"/>
                <field name="delete_enabled" invisible="1"/>
                <group invisible="step != 'client'">
                    <p colspan="2" class="text-muted">Step 1 of 3. One key per client, acting as one dedicated Odoo user.
                        The Administrator cannot be used: it holds every access right.</p>
                    <field name="name" placeholder="e.g. Finance - Claude Desktop" required="step == 'client'"/>
                    <field name="user_id" options="{'no_create': True}" required="step == 'client'"/>
                    <field name="expires_at"/>
                </group>
                <div invisible="step != 'models'">
                    <p class="text-muted">Step 2 of 3. Tick what the client may do per model. The Odoo access column
                        warns when the user's own rights do not allow a ticked action; Odoo will refuse it either way.</p>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="can_read"/>
                            <field name="can_create"/>
                            <field name="can_update"/>
                            <field name="delete_enabled" column_invisible="1"/>
                            <field name="can_delete" readonly="not delete_enabled"/>
                            <field name="field_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="access_warning" decoration-warning="access_warning"/>
                        </list>
                    </field>
                    <p class="text-muted" invisible="delete_enabled">
                        Delete cannot be ticked: deleting is switched off in MCP Settings.</p>
                </div>
                <div invisible="step != 'done'">
                    <div class="alert alert-warning" role="alert">
                        Copy the key now. It is shown only this once; Odoo keeps only a fingerprint of it.
                    </div>
                    <group>
                        <field name="token" widget="CopyClipboardChar"/>
                        <field name="endpoint_url" widget="CopyClipboardChar"/>
                        <field name="config_desktop" widget="CopyClipboardText"/>
                        <field name="config_http" widget="CopyClipboardText"/>
                    </group>
                </div>
                <footer>
                    <button name="action_next" type="object" string="Next" class="oe_highlight" invisible="step != 'client'"/>
                    <button name="action_back" type="object" string="Back" invisible="step != 'models'"/>
                    <button name="action_create" type="object" string="Create key" class="oe_highlight" invisible="step != 'models'"/>
                    <button name="action_done" type="object" string="I have copied the key" class="oe_highlight" invisible="step != 'done'"/>
                    <button special="cancel" string="Cancel" class="btn-secondary" invisible="step == 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mcp_key_wizard" model="ir.actions.act_window">
        <field name="name">New MCP key</field>
        <field name="res_model">kaitech.mcp.key.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
